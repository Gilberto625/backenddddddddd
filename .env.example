# Django Settings
SECRET_KEY=tu-secret-key-super-segura-aqui-cambiar-en-produccion
DEBUG=False
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1

# Database (PostgreSQL en producción, SQLite en desarrollo)
# Para Render: Esta variable se configura automáticamente desde la base de datos PostgreSQL
DATABASE_URL=postgres://usuario:password@host:5432/nombre_db

# Email Configuration (Gmail SMTP)
# Para obtener EMAIL_HOST_PASSWORD:
# 1. Ve a tu cuenta de Google
# 2. Activa la verificación en dos pasos
# 3. Ve a "Contraseñas de aplicaciones"
# 4. Genera una nueva contraseña para "Correo"
# 5. Copia la contraseña de 16 dígitos aquí
EMAIL_HOST_USER=tu-email@gmail.com
EMAIL_HOST_PASSWORD=tu-app-password-de-gmail-aqui

# CORS Configuration (URLs del frontend)
# Ejemplo para Vercel: https://tu-app.vercel.app
# Separar múltiples URLs con comas
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://tu-frontend.vercel.app

# CSRF Trusted Origins (Backend + Frontend URLs)
# Ejemplo: https://tu-backend.onrender.com,https://tu-frontend.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:4200,https://tu-backend.onrender.com,https://tu-frontend.vercel.app

# Firebase Credentials (para Google Login)
# Opción 1: Variable de entorno con el contenido completo del archivo JSON
# FIREBASE_CREDENTIALS={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}
#
# Opción 2: Dejar vacío y usar archivo local config/firebase-service-account.json (solo para desarrollo)
FIREBASE_CREDENTIALS=

# NOTAS IMPORTANTES:
# 1. NO subir este archivo a Git con valores reales
# 2. En Render, configurar estas variables en el dashboard (Environment)
# 3. Generar SECRET_KEY con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
